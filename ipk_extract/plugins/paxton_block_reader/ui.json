{
    "plugin": true,
    "name": "Paxton Block Reader",
    "version": "1.0.4",
    "initial_state": "idle",
    "states": {
        "idle": {
            "screen": {
                "title": "Paxton Block Reader",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Place Paxton Tag on the reader and press \"Read\" to begin.",
                            "size": "medium",
                            "align": "center"
                        }
                    ]
                },
                "buttons": {
                    "left": "Back",
                    "right": "Read"
                },
                "keys": {
                    "OK": "set_state:reading",
                    "M2": "set_state:reading",
                    "M1": "finish"
                }
            }
        },
        "reading": {
            "on_enter": "run:do_read",
            "screen": {
                "title": "Paxton Block Reader",
                "content": {
                    "type": "progress",
                    "message": "{progress_message}",
                    "value": "{progress_value}",
                    "max": 100
                },
                "buttons": {
                    "left": null,
                    "right": null
                }
            },
            "transitions": {
                "on_result.status==done": "result",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "result": {
            "screen": {
                "title": "Paxton Block Reader",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Type:  {pax_type}",
                            "size": "medium"
                        },
                        {
                            "text": "UID:   {uid}",
                            "size": "medium"
                        },
                        {
                            "text": "{pax_id_line}",
                            "size": "medium"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "Press Next to View Blocks",
                            "size": "medium",
                            "align": "center"
                        }
                    ]
                },
                "buttons": {
                    "left": "Back",
                    "right": "Next"
                },
                "keys": {
                    "OK": "set_state:result_p2",
                    "M2": "set_state:result_p2",
                    "M1": "finish"
                }
            }
        },
        "result_p2": {
            "screen": {
                "title": "Paxton Block Reader",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "B0: {blk0}",
                            "size": "medium"
                        },
                        {
                            "text": "B1: {blk1}",
                            "size": "medium"
                        },
                        {
                            "text": "B2: {blk2}",
                            "size": "medium"
                        },
                        {
                            "text": "B3: {blk3}",
                            "size": "medium"
                        },
                        {
                            "text": "B4: {blk4}",
                            "size": "medium"
                        },
                        {
                            "text": "B5: {blk5}",
                            "size": "medium"
                        },
                        {
                            "text": "B6: {blk6}",
                            "size": "medium"
                        },
                        {
                            "text": "B7: {blk7}",
                            "size": "medium"
                        }
                    ]
                },
                "buttons": {
                    "left": "Prev",
                    "right": "Again"
                },
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "set_state:result"
                }
            }
        },
        "error": {
            "screen": {
                "title": "Paxton Block Reader",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "{error_msg}",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "Is it a Paxton tag?",
                            "size": "medium",
                            "align": "center"
                        }
                    ]
                },
                "buttons": {
                    "left": "Back",
                    "right": "Retry"
                },
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "finish"
                }
            }
        }
    }
}
