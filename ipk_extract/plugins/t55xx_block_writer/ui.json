{
    "plugin": true,
    "name": "T55xx Block Writer",
    "version": "1.0.3",
    "initial_state": "warning",
    "states": {
        "warning": {
            "on_enter": "run:do_init",
            "screen": {
                "title": "T55xx Block Writer",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "WARNING!",                      "size": "large",  "align": "center"},
                        {"text": "Block writes can brick your tag permanently.", "size": "medium", "align": "center"},
                        {"text": ""},
                        {"text": "Do you understand the risks?",   "size": "medium", "align": "center"},
                        {"text": ""}
                    ]
                },
                "buttons": {"left": "Back", "right": "I Understand"},
                "keys": {
                    "M1": "finish",
                    "M2": "set_state:page_picker"
                }
            }
        },
        "page_picker": {
            "screen": {
                "title": "T55xx Block Writer",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Select page",       "size": "medium", "align": "center"},
                        {"text": ""},
                        {"text": "{page_num}",         "size": "xlarge", "align": "center"},
                        {"text": ""},
                        {"text": "UP/DOWN to cycle",  "size": "medium", "align": "center"},
                        {"text": "OK/M2 to confirm",   "size": "medium", "align": "center"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Confirm"},
                "keys": {
                    "UP":    "run:do_cycle_page",
                    "RIGHT": "run:do_cycle_page",
                    "DOWN":  "run:do_cycle_page",
                    "LEFT":  "run:do_cycle_page",
                    "OK":    "run:do_confirm_page",
                    "M2":    "run:do_confirm_page",
                    "M1":    "finish"
                }
            },
            "transitions": {
                "on_result.status==confirmed": "idle",
                "on_result.status==page1":     "page1_notice"
            }
        },
        "page1_notice": {
            "screen": {
                "title": "T55xx Block Writer",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Page 1: Traceability", "size": "large", "align": "center"},
                        {"text": ""},
                        {"text": "Traceability data is usually locked, so expect writes to fail unless your tag allows changing this.", "size": "medium", "align": "center"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Continue"},
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "set_state:page_picker"
                }
            }
        },
        "idle": {
            "screen": {
                "title": "T55xx Block Writer",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Page {page_num} block", "size": "medium", "align": "center"},
                        {"text": ""},
                        {"text": "{block_num}",           "size": "xlarge", "align": "center"},
                        {"text": ""},
                        {"text": "UP/DOWN to cycle",      "size": "medium", "align": "center"},
                        {"text": "OK/M2 to confirm",      "size": "medium", "align": "center"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Confirm"},
                "keys": {
                    "UP":    "run:do_cycle",
                    "RIGHT": "run:do_cycle",
                    "DOWN":  "run:do_cycle_down",
                    "LEFT":  "run:do_cycle_down",
                    "OK":    "run:do_confirm",
                    "M2":    "run:do_confirm",
                    "M1":    "set_state:page_picker"
                }
            },
            "transitions": {
                "on_result.status==confirmed": "input_data"
            }
        },
        "input_data": {
            "screen": {
                "title": "T55xx Block Writer",
                "content": {
                    "type": "input_hex",
                    "label": "Enter data to write",
                    "length": 8,
                    "placeholder": "00000000"
                },
                "buttons": {"left": "Back", "right": "Next"},
                "keys": {
                    "OK": "run:do_capture_data",
                    "M2": "run:do_capture_data",
                    "M1": "set_state:idle"
                }
            },
            "transitions": {
                "on_result.status==captured": "input_pwd_choice",
                "on_result.status==error":    "error",
                "on_error":                   "error"
            }
        },
        "input_pwd_choice": {
            "screen": {
                "title": "T55xx Block Writer",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Page {page_num} block {selected_block}", "size": "medium", "align": "center"},
                        {"text": "Data:  {data}", "size": "medium", "align": "center"},
                        {"text": ""},
                        {"text": "Use password?", "size": "medium", "align": "center"}
                    ]
                },
                "buttons": {"left": "No Pwd", "right": "With Pwd"},
                "keys": {
                    "OK": "set_state:writing",
                    "M1": "set_state:writing",
                    "M2": "set_state:input_pwd"
                }
            }
        },
        "input_pwd": {
            "screen": {
                "title": "T55xx Block Writer",
                "content": {
                    "type": "input_hex",
                    "label": "Enter password",
                    "length": 8,
                    "placeholder": "00000000"
                },
                "buttons": {"left": "Back", "right": "Write"},
                "keys": {
                    "OK": "run:do_capture_pwd",
                    "M2": "run:do_capture_pwd",
                    "M1": "set_state:input_pwd_choice"
                }
            },
            "transitions": {
                "on_result.status==captured": "writing_pwd",
                "on_result.status==error":    "error",
                "on_error":                   "error"
            }
        },
        "writing": {
            "on_enter": "run:do_write",
            "screen": {
                "title": "T55xx Block Writer",
                "content": {
                    "type": "progress",
                    "message": "{progress_message}",
                    "value": "{progress_value}",
                    "max": 100
                },
                "buttons": {"left": null, "right": null}
            },
            "transitions": {
                "on_result.status==done":     "done",
                "on_result.status==mismatch": "verify_mismatch",
                "on_result.status==noverify": "verify_fail",
                "on_result.status==error":    "error",
                "on_error":                   "error"
            }
        },
        "writing_pwd": {
            "on_enter": "run:do_write_pwd",
            "screen": {
                "title": "T55xx Block Writer",
                "content": {
                    "type": "progress",
                    "message": "{progress_message}",
                    "value": "{progress_value}",
                    "max": 100
                },
                "buttons": {"left": null, "right": null}
            },
            "transitions": {
                "on_result.status==done":     "done",
                "on_result.status==mismatch": "verify_mismatch",
                "on_result.status==noverify": "verify_fail",
                "on_result.status==error":    "error",
                "on_error":                   "error"
            }
        },
        "done": {
            "screen": {
                "title": "T55xx Block Writer",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Write OK!",                    "size": "large",  "align": "center"},
                        {"text": "Verified",                     "size": "medium", "align": "center"},
                        {"text": ""},
                        {"text": "Pg {page_num} blk {selected_block}", "size": "medium", "align": "center"},
                        {"text": "Data: {data}",                 "size": "medium", "align": "center"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Again"},
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "finish"
                }
            }
        },
        "verify_mismatch": {
            "screen": {
                "title": "T55xx Block Writer",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Verify mismatch", "size": "large",  "align": "center"},
                        {"text": ""},
                        {"text": "Wrote: {data}",   "size": "medium", "align": "center"},
                        {"text": "Read:  {readback}", "size": "medium", "align": "center"},
                        {"text": "{verify_note}",   "size": "medium", "align": "center"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Again"},
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "finish"
                }
            }
        },
        "verify_fail": {
            "screen": {
                "title": "T55xx Block Writer",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Could not verify,",  "size": "large",  "align": "center"},
                        {"text": "has the tag moved?",  "size": "medium", "align": "center"},
                        {"text": ""},
                        {"text": "{verify_note}",       "size": "medium", "align": "center"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Retry"},
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "finish"
                }
            }
        },
        "error": {
            "screen": {
                "title": "T55xx Block Writer",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Write failed",         "size": "large",  "align": "center"},
                        {"text": ""},
                        {"text": "Check tag present",    "size": "medium", "align": "center"},
                        {"text": "and password correct", "size": "medium", "align": "center"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Retry"},
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "finish"
                }
            }
        }
    }
}
