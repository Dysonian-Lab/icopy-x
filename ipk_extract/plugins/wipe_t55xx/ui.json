{
    "plugin": true,
    "name": "T55xx Wipe",
    "version": "1.0.4",
    "initial_state": "idle",
    "states": {
        "idle": {
            "screen": {
                "title": "T55xx Wipe",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Place T55xx on reader", "size": "medium"},
                        {"text": ""},
                        {"text": "Wipe with password?", "size": "medium"}
                    ]
                },
                "buttons": {"left": "No Pwd", "right": "With Pwd"},
                "keys": {
                    "OK": "set_state:input_pwd",
                    "M2": "set_state:input_pwd",
                    "M1": "set_state:wiping"
                }
            }
        },
        "input_pwd": {
            "screen": {
                "title": "T55xx Wipe",
                "content": {
                    "type": "input_hex",
                    "label": "Current password",
                    "length": 8,
                    "placeholder": "00000000"
                },
                "buttons": {"left": "Back", "right": "Wipe"},
                "keys": {
                    "OK": "run:do_capture_pwd",
                    "M2": "run:do_capture_pwd",
                    "M1": "set_state:idle"
                }
            },
            "transitions": {
                "on_result.status==ok": "wiping_pwd",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "wiping_pwd": {
            "on_enter": "run:do_wipe_pwd",
            "screen": {
                "title": "T55xx Wipe",
                "content": {
                    "type": "progress",
                    "message": "{progress_message}",
                    "value": "{progress_value}",
                    "max": 100
                },
                "buttons": {"left": null, "right": null}
            },
            "transitions": {
                "on_result.status==done": "done",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "wiping": {
            "on_enter": "run:do_wipe",
            "screen": {
                "title": "T55xx Wipe",
                "content": {
                    "type": "progress",
                    "message": "{progress_message}",
                    "value": "{progress_value}",
                    "max": 100
                },
                "buttons": {"left": null, "right": null}
            },
            "transitions": {
                "on_result.status==done": "done",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "done": {
            "screen": {
                "title": "T55xx Wipe",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Wipe complete!", "size": "medium"},
                        {"text": ""},
                        {"text": "{done_msg}", "size": "medium"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Again"},
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "finish"
                }
            }
        },
        "error": {
            "screen": {
                "title": "T55xx Wipe",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "{error_msg}", "size": "medium"},
                        {"text": ""},
                        {"text": "Press OK to retry", "size": "medium"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Again"},
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "finish"
                }
            }
        }
    }
}
