{
    "plugin": true,
    "name": "Chk T55xx Pwds",
    "version": "1.0.0",
    "initial_state": "idle",
    "states": {
        "idle": {
            "screen": {
                "title": "Chk T55xx Pwds",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Place T55xx tag on reader", "size": "medium"},
                        {"text": ""},
                        {"text": "Press OK or Start", "size": "medium"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Start"},
                "keys": {
                    "OK": "set_state:checking",
                    "M2": "set_state:checking",
                    "M1": "finish"
                }
            }
        },
        "checking": {
            "on_enter": "run:do_check",
            "screen": {
                "title": "Chk T55xx Pwds",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Checking T55xx passwords...", "size": "medium"},
                        {"text": ""},
                        {"text": "This can take up to 40s", "size": "medium"},
                        {"text": "Please wait", "size": "medium"}
                    ]
                },
                "buttons": {"left": null, "right": null}
            },
            "transitions": {
                "on_result.status==found": "found",
                "on_result.status==no_pwd": "no_pwd",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "found": {
            "screen": {
                "title": "Chk T55xx Pwds",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Password found:", "size": "medium"},
                        {"text": "{found_pwds}", "size": "medium"},
                        {"text": ""},
                        {"text": "Wipe tag with this password?", "size": "medium"}
                    ]
                },
                "buttons": {"left": "Skip", "right": "Wipe"},
                "keys": {
                    "OK": "set_state:wiping",
                    "M2": "set_state:wiping",
                    "M1": "set_state:idle"
                }
            }
        },
        "wiping": {
            "on_enter": "run:do_wipe",
            "screen": {
                "title": "Chk T55xx Pwds",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Wiping tag...", "size": "medium"},
                        {"text": ""},
                        {"text": "Please wait", "size": "medium"}
                    ]
                },
                "buttons": {"left": null, "right": null}
            },
            "transitions": {
                "on_result.status==done": "done",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "done": {
            "screen": {
                "title": "Chk T55xx Pwds",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Wipe complete!", "size": "medium"},
                        {"text": ""},
                        {"text": "Password was:", "size": "medium"},
                        {"text": "{found_pwd}", "size": "medium"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Again"},
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "finish"
                }
            }
        },
        "no_pwd": {
            "screen": {
                "title": "Chk T55xx Pwds",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "No password found", "size": "medium"},
                        {"text": ""},
                        {"text": "Press OK to retry", "size": "medium"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Again"},
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "finish"
                }
            }
        },
        "error": {
            "screen": {
                "title": "Chk T55xx Pwds",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "{error_msg}", "size": "medium"},
                        {"text": ""},
                        {"text": "Press OK to retry", "size": "medium"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Again"},
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "finish"
                }
            }
        }
    }
}
