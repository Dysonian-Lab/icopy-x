{
    "plugin": true,
    "name": "LF Clone & Pwd",
    "version": "1.0.0",
    "initial_state": "info",
    "states": {
        "info": {
            "screen": {
                "title": "LF Clone & Pwd",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Pwd bit supported:",
                            "size": "medium"
                        },
                        {
                            "text": "HID Indala AWID IOProx",
                            "size": "medium"
                        },
                        {
                            "text": "GProx Viking Pyramid",
                            "size": "medium"
                        },
                        {
                            "text": "Jablotron PAC FDX-B",
                            "size": "medium"
                        },
                        {
                            "text": "KERI Securakey",
                            "size": "medium"
                        },
                        {
                            "text": "Gallagher Paradox",
                            "size": "medium"
                        },
                        {
                            "text": "NexWatch",
                            "size": "medium"
                        },
                        {
                            "text": ""
                        }
                    ]
                },
                "buttons": {
                    "left": "Back",
                    "right": "Next"
                },
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "finish"
                }
            }
        },
        "idle": {
            "screen": {
                "title": "LF Clone & Pwd",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Place source LF tag",
                            "size": "medium"
                        },
                        {
                            "text": "on reader",
                            "size": "medium"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "Press OK to scan",
                            "size": "medium"
                        }
                    ]
                },
                "buttons": {
                    "left": "Back",
                    "right": "Scan"
                },
                "keys": {
                    "OK": "set_state:scanning",
                    "M2": "set_state:scanning",
                    "M1": "finish"
                }
            }
        },
        "scanning": {
            "on_enter": "run:do_scan",
            "screen": {
                "title": "LF Clone & Pwd",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Scanning LF tag...",
                            "size": "medium"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "Please wait",
                            "size": "medium"
                        }
                    ]
                },
                "buttons": {
                    "left": null,
                    "right": null
                }
            },
            "transitions": {
                "on_result.status==found": "scan_result",
                "on_result.status==found_no_lock": "scan_result_no_lock",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "scan_result": {
            "screen": {
                "title": "LF Clone & Pwd",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "{tag_name}",
                            "size": "medium"
                        },
                        {
                            "text": "{tag_id}",
                            "size": "medium"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "Dump & continue?",
                            "size": "medium"
                        }
                    ]
                },
                "buttons": {
                    "left": "Cancel",
                    "right": "Next"
                },
                "keys": {
                    "OK": "set_state:dumping",
                    "M2": "set_state:dumping",
                    "M1": "set_state:idle"
                }
            }
        },
        "scan_result_no_lock": {
            "screen": {
                "title": "LF Clone & Pwd",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "{tag_name}",
                            "size": "medium"
                        },
                        {
                            "text": "{tag_id}",
                            "size": "medium"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "Clone only (no lock)",
                            "size": "medium"
                        },
                        {
                            "text": "Dump & continue?",
                            "size": "medium"
                        }
                    ]
                },
                "buttons": {
                    "left": "Cancel",
                    "right": "Next"
                },
                "keys": {
                    "OK": "set_state:dumping_no_lock",
                    "M2": "set_state:dumping_no_lock",
                    "M1": "set_state:idle"
                }
            }
        },
        "dumping": {
            "on_enter": "run:do_dump",
            "screen": {
                "title": "LF Clone & Pwd",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Saving dump...",
                            "size": "medium"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "Please wait",
                            "size": "medium"
                        }
                    ]
                },
                "buttons": {
                    "left": null,
                    "right": null
                }
            },
            "transitions": {
                "on_result.status==done": "swap",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "dumping_no_lock": {
            "on_enter": "run:do_dump",
            "screen": {
                "title": "LF Clone & Pwd",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Saving dump...",
                            "size": "medium"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "Please wait",
                            "size": "medium"
                        }
                    ]
                },
                "buttons": {
                    "left": null,
                    "right": null
                }
            },
            "transitions": {
                "on_result.status==done": "swap_no_lock",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "swap": {
            "screen": {
                "title": "LF Clone & Pwd",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Remove source tag",
                            "size": "medium"
                        },
                        {
                            "text": "Place blank T55xx",
                            "size": "medium"
                        },
                        {
                            "text": "on reader",
                            "size": "medium"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "Write with password?",
                            "size": "medium"
                        }
                    ]
                },
                "buttons": {
                    "left": "No Pwd",
                    "right": "Set Pwd"
                },
                "keys": {
                    "OK": "set_state:input_pwd",
                    "M2": "set_state:input_pwd",
                    "M1": "set_state:writing"
                }
            }
        },
        "swap_no_lock": {
            "screen": {
                "title": "LF Clone & Pwd",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Remove source tag",
                            "size": "medium"
                        },
                        {
                            "text": "Place blank T55xx",
                            "size": "medium"
                        },
                        {
                            "text": "on reader",
                            "size": "medium"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "Lock not supported",
                            "size": "medium"
                        },
                        {
                            "text": "for this tag type",
                            "size": "medium"
                        }
                    ]
                },
                "buttons": {
                    "left": "Cancel",
                    "right": "Write"
                },
                "keys": {
                    "OK": "set_state:writing",
                    "M2": "set_state:writing",
                    "M1": "set_state:idle"
                }
            }
        },
        "input_pwd": {
            "screen": {
                "title": "LF Clone & Pwd",
                "content": {
                    "type": "input_hex",
                    "label": "Password to set",
                    "length": 8,
                    "placeholder": "00000000"
                },
                "buttons": {
                    "left": "Back",
                    "right": "Set"
                },
                "keys": {
                    "OK": "run:do_write_pwd",
                    "M2": "run:do_write_pwd",
                    "M1": "set_state:swap"
                }
            },
            "transitions": {
                "on_result.status==writing": "writing_pwd",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "writing_pwd": {
            "on_enter": "run:do_write_actual",
            "screen": {
                "title": "LF Clone & Pwd",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Writing with password",
                            "size": "medium"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "Please wait...",
                            "size": "medium"
                        }
                    ]
                },
                "buttons": {
                    "left": null,
                    "right": null
                }
            },
            "transitions": {
                "on_result.status==done": "done",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "writing": {
            "on_enter": "run:do_write",
            "screen": {
                "title": "LF Clone & Pwd",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Writing to T55xx...",
                            "size": "medium"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "Please wait",
                            "size": "medium"
                        }
                    ]
                },
                "buttons": {
                    "left": null,
                    "right": null
                }
            },
            "transitions": {
                "on_result.status==done": "done",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "done": {
            "screen": {
                "title": "LF Clone & Pwd",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Clone complete!",
                            "size": "medium"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "{done_msg}",
                            "size": "medium"
                        }
                    ]
                },
                "buttons": {
                    "left": "Back",
                    "right": "Again"
                },
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "finish"
                }
            }
        },
        "error": {
            "screen": {
                "title": "LF Clone & Pwd",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "{error_msg}",
                            "size": "medium"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "Press OK to retry",
                            "size": "medium"
                        }
                    ]
                },
                "buttons": {
                    "left": "Back",
                    "right": "Again"
                },
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "finish"
                }
            }
        }
    }
}
