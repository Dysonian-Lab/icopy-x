{
    "plugin": true,
    "name": "PAC Clone & Lock",
    "version": "1.0.0",
    "initial_state": "idle",
    "states": {
        "idle": {
            "screen": {
                "title": "PAC Clone & Lock",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Place PAC tag on reader", "size": "normal"},
                        {"text": ""},
                        {"text": "Press OK to scan", "size": "normal"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Scan"},
                "keys": {
                    "OK": "set_state:scanning",
                    "M2": "set_state:scanning",
                    "M1": "finish"
                }
            }
        },
        "scanning": {
            "on_enter": "run:do_scan",
            "screen": {
                "title": "PAC Clone & Lock",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Scanning...", "size": "normal"},
                        {"text": ""},
                        {"text": "Please wait", "size": "normal"}
                    ]
                },
                "buttons": {"left": null, "right": null}
            },
            "transitions": {
                "on_result.status==found": "scan_result",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "scan_result": {
            "screen": {
                "title": "PAC Clone & Lock",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "PAC Tag Found", "size": "normal"},
                        {"text": "{tag_id}", "size": "normal"},
                        {"text": ""},
                        {"text": "Dump & continue?", "size": "normal"}
                    ]
                },
                "buttons": {"left": "Cancel", "right": "Next"},
                "keys": {
                    "OK": "set_state:dumping",
                    "M2": "set_state:dumping",
                    "M1": "set_state:idle"
                }
            }
        },
        "dumping": {
            "on_enter": "run:do_dump",
            "screen": {
                "title": "PAC Clone & Lock",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Saving dump...", "size": "normal"},
                        {"text": ""},
                        {"text": "Please wait", "size": "normal"}
                    ]
                },
                "buttons": {"left": null, "right": null}
            },
            "transitions": {
                "on_result.status==done": "swap",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "swap": {
            "screen": {
                "title": "PAC Clone & Lock",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Remove PAC tag", "size": "normal"},
                        {"text": "Place blank T55xx", "size": "normal"},
                        {"text": "on reader", "size": "normal"},
                        {"text": ""},
                        {"text": "Write with password?", "size": "normal"}
                    ]
                },
                "buttons": {"left": "No Pwd", "right": "Set Pwd"},
                "keys": {
                    "OK": "set_state:input_pwd",
                    "M2": "set_state:input_pwd",
                    "M1": "set_state:writing"
                }
            }
        },
        "input_pwd": {
            "screen": {
                "title": "PAC Clone & Lock",
                "content": {
                    "type": "input_hex",
                    "label": "Password to set",
                    "length": 8,
                    "placeholder": "00000000"
                },
                "buttons": {"left": "Back", "right": "Set"},
                "keys": {
                    "OK": "run:do_write_pwd",
                    "M2": "run:do_write_pwd",
                    "M1": "set_state:swap"
                }
            },
            "transitions": {
                "on_result.status==writing": "writing_pwd",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "writing_pwd": {
            "on_enter": "run:do_write_actual",
            "screen": {
                "title": "PAC Clone & Lock",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Writing with password", "size": "normal"},
                        {"text": ""},
                        {"text": "Please wait...", "size": "normal"}
                    ]
                },
                "buttons": {"left": null, "right": null}
            },
            "transitions": {
                "on_result.status==done": "done",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "writing": {
            "on_enter": "run:do_write",
            "screen": {
                "title": "PAC Clone & Lock",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Writing to T55xx...", "size": "normal"},
                        {"text": ""},
                        {"text": "Please wait", "size": "normal"}
                    ]
                },
                "buttons": {"left": null, "right": null}
            },
            "transitions": {
                "on_result.status==done": "done",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "done": {
            "screen": {
                "title": "PAC Clone & Lock",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Clone complete!", "size": "normal"},
                        {"text": ""},
                        {"text": "{done_msg}", "size": "normal"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Again"},
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "finish"
                }
            }
        },
        "error": {
            "screen": {
                "title": "PAC Clone & Lock",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "{error_msg}", "size": "normal"},
                        {"text": ""},
                        {"text": "Press OK to retry", "size": "normal"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Again"},
                "keys": {
                    "OK": "set_state:idle",
                    "M2": "set_state:idle",
                    "M1": "finish"
                }
            }
        }
    }
}
