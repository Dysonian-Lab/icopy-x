{
    "plugin": true,
    "name": "T55xx Block Reader",
    "version": "1.0.0",
    "initial_state": "page_picker",
    "states": {
        "page_picker": {
            "on_enter": "run:do_init",
            "screen": {
                "title": "T55xx Block Reader",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Select page",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "{page_num}",
                            "size": "xlarge",
                            "align": "center"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "UP/RIGHT to cycle",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": "OK/M2 to confirm",
                            "size": "medium",
                            "align": "center"
                        }
                    ]
                },
                "buttons": {
                    "left": "Back",
                    "right": "Confirm"
                },
                "keys": {
                    "UP": "run:do_cycle_page",
                    "RIGHT": "run:do_cycle_page",
                    "DOWN": "noop",
                    "LEFT": "noop",
                    "OK": "run:do_confirm_page",
                    "M2": "run:do_confirm_page",
                    "M1": "finish"
                }
            },
            "transitions": {
                "on_result.status==confirmed": "idle"
            }
        },
        "idle": {
            "screen": {
                "title": "T55xx Block Reader",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Read mode",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "M1 = Single block",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": "M2 = Block range",
                            "size": "medium",
                            "align": "center"
                        }
                    ]
                },
                "buttons": {
                    "left": "Single",
                    "right": "Range"
                },
                "keys": {
                    "M1": "set_state:block_picker",
                    "M2": "set_state:range_start"
                }
            }
        },
        "block_picker": {
            "screen": {
                "title": "T55xx Block Reader",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Select block",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "{block_num}",
                            "size": "xlarge",
                            "align": "center"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "UP/RIGHT to cycle",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": "OK/M2 to confirm",
                            "size": "medium",
                            "align": "center"
                        }
                    ]
                },
                "buttons": {
                    "left": "Back",
                    "right": "Confirm"
                },
                "keys": {
                    "UP": "run:do_cycle",
                    "RIGHT": "run:do_cycle",
                    "DOWN": "noop",
                    "LEFT": "noop",
                    "OK": "run:do_confirm_single",
                    "M2": "run:do_confirm_single",
                    "M1": "set_state:idle"
                }
            },
            "transitions": {
                "on_result.status==confirmed": "input_pwd_choice"
            }
        },
        "range_start": {
            "screen": {
                "title": "T55xx Block Reader",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Select start block",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "{block_num}",
                            "size": "xlarge",
                            "align": "center"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "UP/RIGHT to cycle",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": "OK/M2 to confirm",
                            "size": "medium",
                            "align": "center"
                        }
                    ]
                },
                "buttons": {
                    "left": "Back",
                    "right": "Confirm"
                },
                "keys": {
                    "UP": "run:do_cycle",
                    "RIGHT": "run:do_cycle",
                    "DOWN": "noop",
                    "LEFT": "noop",
                    "OK": "run:do_confirm_start",
                    "M2": "run:do_confirm_start",
                    "M1": "set_state:idle"
                }
            },
            "transitions": {
                "on_result.status==confirmed": "range_end"
            }
        },
        "range_end": {
            "screen": {
                "title": "T55xx Block Reader",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Select end block",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": "Start: {range_start}",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": "{block_num}",
                            "size": "xlarge",
                            "align": "center"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "UP/RIGHT to cycle",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": "OK/M2 to confirm",
                            "size": "medium",
                            "align": "center"
                        }
                    ]
                },
                "buttons": {
                    "left": "Back",
                    "right": "Confirm"
                },
                "keys": {
                    "UP": "run:do_cycle_end",
                    "RIGHT": "run:do_cycle_end",
                    "DOWN": "noop",
                    "LEFT": "noop",
                    "OK": "run:do_confirm_end",
                    "M2": "run:do_confirm_end",
                    "M1": "set_state:range_start"
                }
            },
            "transitions": {
                "on_result.status==confirmed": "input_pwd_choice"
            }
        },
        "input_pwd_choice": {
            "screen": {
                "title": "T55xx Block Reader",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Read with password?",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "M1 = No password",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": "M2 = With password",
                            "size": "medium",
                            "align": "center"
                        }
                    ]
                },
                "buttons": {
                    "left": "No Pwd",
                    "right": "With Pwd"
                },
                "keys": {
                    "M1": "run:do_read",
                    "M2": "set_state:input_pwd"
                }
            },
            "transitions": {
                "on_result.status==done": "result",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "input_pwd": {
            "screen": {
                "title": "T55xx Block Reader",
                "content": {
                    "type": "input_hex",
                    "label": "Enter password",
                    "length": 8,
                    "placeholder": "00000000"
                },
                "buttons": {
                    "left": "Back",
                    "right": "Read"
                },
                "keys": {
                    "OK": "run:do_read_pwd",
                    "M2": "run:do_read_pwd",
                    "M1": "set_state:input_pwd_choice"
                }
            },
            "transitions": {
                "on_result.status==done": "result",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "result": {
            "screen": {
                "title": "T55xx Block Reader",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "{result_l0}",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": "{result_l1}",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": "{result_l2}",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": "{result_l3}",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": "{result_l4}",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": "{result_l5}",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": "{result_l6}",
                            "size": "medium",
                            "align": "center"
                        },
                        {
                            "text": "{result_l7}",
                            "size": "medium",
                            "align": "center"
                        }
                    ]
                },
                "buttons": {
                    "left": "Back",
                    "right": "Again"
                },
                "keys": {
                    "M1": "finish",
                    "M2": "set_state:idle",
                    "OK": "set_state:idle"
                }
            }
        },
        "error": {
            "screen": {
                "title": "T55xx Block Reader",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Read failed",
                            "size": "large",
                            "align": "center"
                        },
                        {
                            "text": ""
                        },
                        {
                            "text": "Is tag pwd protected?",
                            "size": "medium",
                            "align": "center"
                        }
                    ]
                },
                "buttons": {
                    "left": "Back",
                    "right": "Retry"
                },
                "keys": {
                    "M1": "finish",
                    "M2": "set_state:idle",
                    "OK": "set_state:idle"
                }
            }
        }
    }
}
