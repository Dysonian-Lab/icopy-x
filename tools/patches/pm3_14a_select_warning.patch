Applies to the pre-WaitForIso14aReply client (checked: v4.21128, v4.21611).
For v4.23346, use the companion pm3_14a_select_warning_modern.patch.
The two variants are mutually exclusive; only one should apply.

diff --git a/client/src/cmdhf14a.c b/client/src/cmdhf14a.c
index dc3066b..6eb1e74 100644
--- a/client/src/cmdhf14a.c
+++ b/client/src/cmdhf14a.c
@@ -268,7 +268,7 @@ int hf14a_getversion_data(iso14a_card_select_t *card, uint64_t select_status, ve
             DropField();
 
             if (res == PM3_ETIMEOUT) {
-                PrintAndLogEx(DEBUG, "iso14443a card select timeout");
+                PrintAndLogEx(WARNING, "iso14443a card select timeout");
                 return PM3_ETIMEOUT;
             }
 
@@ -2718,6 +2718,6 @@ int infoHF14A(bool verbose, bool do_nack_test, bool do_aid_search) {
     PacketResponseNG resp;
     if (WaitForResponseTimeout(CMD_ACK, &resp, 2500) == false) {
-        PrintAndLogEx(DEBUG, "iso14443a card select timeout");
+        PrintAndLogEx(WARNING, "iso14443a card select timeout");
         DropField();
         return PM3_ETIMEOUT;
     }
@@ -2735,7 +2735,7 @@ int infoHF14A(bool verbose, bool do_nack_test, bool do_aid_search) {
     uint64_t select_status = resp.oldarg[0];
 
     if (select_status == 0) {
-        PrintAndLogEx(DEBUG, "iso14443a card select failed");
+        PrintAndLogEx(WARNING, "iso14443a card select failed");
         DropField();
         return select_status;
     }
